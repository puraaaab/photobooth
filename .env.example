# Copy to .env (never commit .env). Restart the server after changes.

# Razorpay (Dashboard → Account & Settings → API Keys). Leave empty to disable online payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
VITE_RAZORPAY_KEY_ID=

# Staff PIN (4-8 digits) that remote stations (editing iPad, booth Pi) must enter for staff
# actions: cash/UPI upgrade approval, reprints, issuing tickets from a tablet.
# If unset, a random 6-digit PIN is generated once and saved to data/staff-pin.txt.
STAFF_PIN=

# Optional
# PORT=3847
# DATA_DIR=./data
