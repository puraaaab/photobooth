{
  "name": "photobooth-editor",
  "version": "1.0.0",
  "description": "Professional photobooth editor for Raspberry Pi kiosk and web",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:server\"",
    "dev:vite": "vite",
    "dev:server": "npx tsx watch server/index.ts",
    "server": "npx tsx server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "camera:server": "node pi-setup/camera-server.js",
    "build:templates": "node scripts/rebuildAllCleanTemplatesFromRemovedBg.cjs",
    "extract-stickers": "node scripts/autoExtractStickerSheet.cjs",
    "start": "npx tsx server/index.ts",
    "build:start": "vite build && npx tsx server/index.ts",
    "test:negative": "node tests/negative.mjs",
    "test:print": "node tests/print.mjs",
    "test:pwg": "npx tsx tests/pwg-raster.test.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/nodemailer": "^8.0.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "framer-motion": "^11.18.2",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.474.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.10",
    "qrcode.react": "^4.2.0",
    "rate-limiter-flexible": "^5.0.5",
    "razorpay": "^2.9.8",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.1.0",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^44.7.0",
    "ssh2": "^1.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vite": "^6.2.6"
  }
}
